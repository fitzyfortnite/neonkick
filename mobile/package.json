{
  "name": "neonkick-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "NeonKick iOS sarmalayıcısı (Capacitor). www/ klasörü derleme sırasında ../server/public'ten kopyalanır.",
  "scripts": {
    "www": "rm -rf www && cp -R ../server/public www",
    "ios:add": "npx cap add ios",
    "ios:sync": "npx cap sync ios",
    "ios:assets": "npx @capacitor/assets generate --ios --iconBackgroundColor '#070a14' --iconBackgroundColorDark '#070a14' --splashBackgroundColor '#070a14' --splashBackgroundColorDark '#070a14'"
  },
  "dependencies": {
    "@capacitor/core": "^7.4.0",
    "@capacitor/ios": "^7.4.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.0",
    "@capacitor/assets": "^3.0.5"
  }
}
